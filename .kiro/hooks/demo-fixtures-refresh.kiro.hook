{
  "enabled": true,
  "name": "Regenerate the Haunted Gallery",
  "description": "Rebuild deterministic demo fixtures when their generator changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "scripts/make-fixtures.ts",
      "packages/core/src/paw/**/*.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `npm run fixtures` to regenerate fixtures/haunted-gallery deterministically, then run `npm test -w packages/core`. Confirm every gallery file still produces the ghost counts listed in fixtures/haunted-gallery/manifest.json and update the manifest if the change was intended."
  }
}
